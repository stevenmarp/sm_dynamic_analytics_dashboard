<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_sm_analytics">
        <field name="name">Dynamic Analytics</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="group_sm_analytics_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_sm_analytics"/>
    </record>

    <record id="group_sm_analytics_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_sm_analytics"/>
        <field name="implied_ids" eval="[(4, ref('group_sm_analytics_user'))]"/>
    </record>
</odoo>
