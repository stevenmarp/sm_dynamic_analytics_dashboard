<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sm_analytics_user" model="res.groups">
        <field name="name">Dynamic Analytics User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="group_sm_analytics_manager" model="res.groups">
        <field name="name">Dynamic Analytics Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_sm_analytics_user'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sm_analytics_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sm_analytics_manager'))]"/>
    </record>
</odoo>
