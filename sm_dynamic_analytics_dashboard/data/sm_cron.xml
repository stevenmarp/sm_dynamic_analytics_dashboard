<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_sm_analytics_email" model="ir.cron">
        <field name="name">Dynamic Analytics: Scheduled Email</field>
        <field name="model_id" ref="model_sm_analytics_dashboard"/>
        <field name="state">code</field>
        <field name="code">model.sm_cron_send_emails()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
